CUDA_DIR = /usr/local/cuda-10.2
ARCH     = sm_60

NVCC     = $(CUDA_DIR)/bin/nvcc
INCLUDE  = -I$(CUDA_DIR)/targets/ppc64le-linux/include
LIBDIR   = -L$(CUDA_DIR)/targets/ppc64le-linux/lib
LIBS     = $(LIBDIR) -lcufft -lcudart -Wl,-rpath,$(CUDA_DIR)/targets/ppc64le-linux/lib
OMP_FLAG = -Xcompiler -fopenmp -lgomp

TARGET   = navier_stokes_cufftxt
SRC      = NavierStokes_periodic_cufftxt.cu

all:
	$(NVCC) -arch=$(ARCH) -O3 -std=c++14 \
	    $(INCLUDE) $(OMP_FLAG) \
	    -o $(TARGET) $(SRC) $(LIBS)

clean:
	rm -f $(TARGET)